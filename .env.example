# Embedding model (must match the model used to build the index)
# EMBED_MODEL=intfloat/multilingual-e5-small
# EMBED_MAX_TOKENS=512

# Index location
# INDEX_DIR=index

# Answer-generation LLM
# LLM_PROVIDER=openai
# LLM_MODEL=qwen3.6:35b-a3b-q4_K_M
# LLM_URL=http://localhost:11434/v1/chat/completions
# LLM_API_KEY=
# LLM_REASONING=

# Verification LLM — leave unset to use the LLM_ settings above
# VERIFY_PROVIDER=
# VERIFY_MODEL=
# VERIFY_URL=
# VERIFY_API_KEY=
# VERIFY_REASONING=

# Calibration file (produced by claimcal.calibrate)
# CALIBRATION_FILE=calibration.json
